        "pythonCode": "# Keep rows that have a real Call-ID, limit to 15, and CLEAR the Call-ID field\n\noutput = []\n\nfor item in _input.all():\n    call_id = item.json.get(\"Call-ID\", \"\").strip()\n    if call_id and call_id.lower() != \"empty\":\n        item.json[\"Call-ID\"] = \"\"   # <-- clear the cell\n        output.append(item)\n\n# only first 15\nreturn output[:20]\n"
