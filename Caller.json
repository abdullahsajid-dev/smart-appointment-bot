      "parameters": {
        "jsCode": "const out = [];\n\nfor (const it of items) {\n  const r = it.json;\n\n  // 1) Originals\n  const phoneRaw = String(r['PhoneNumber'] ?? '').trim();   // keep EXACT as in sheet\n  const statusRaw = String(r['Status'] ?? '').trim();\n\n  // 2) Normalize for robust checks (remove spaces, keep digits, drop leading '+')\n  const phoneNorm = phoneRaw.replace(/\\s+/g, '').replace(/^\\+/, '');\n  const status = statusRaw.toLowerCase().replace(/\\s+/g, '-'); // handles \"not called\" / \"Not-called\" etc.\n\n  // 3) Pass if status is not-called AND PK/UAE numbers\n  const isTargetStatus = (status === 'not-called');\n  const isPkOrUae = phoneNorm.startsWith('92') || phoneNorm.startsWith('971');\n\n  if (isTargetStatus && isPkOrUae) {\n    out.push({\n      json: {\n        rowNumber: r['row_number'] ?? null,\n        phone: phoneRaw,                 // <-- EXACT same PhoneNumber as input\n        firstName: r['Name'] ?? '',\n        country: r['Country'] ?? ''\n      }\n    });\n  }\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
