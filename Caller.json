    {
      "parameters": {
        "jsCode": "/**\n * --- PURPOSE ---\n * Clean and truncate long names for VAPI.ai (max 40 chars)\n * Also ensure phone numbers are E.164 formatted\n */\n\nconst MAX_NAME_LEN = 40;\n\nfunction cleanName(name) {\n  if (!name) return 'Unknown';\n  let n = String(name)\n    .replace(/[^\\p{L}\\p{N}\\s.'-]/gu, '')   // keep letters/numbers/spaces\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (n.length > MAX_NAME_LEN) n = n.slice(0, MAX_NAME_LEN);\n  if (!n) n = 'Unknown';\n  return n;\n}\n\nfunction toE164(phone) {\n  if (!phone) return '';\n  const digits = String(phone).replace(/[^\\d+]/g, '');\n  return digits.startsWith('+') ? digits : ('+' + digits.replace(/^0+/, ''));\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const cleanedName = cleanName(row.firstName || row.Name || '');\n  const cleanPhone = toE164(row.phone || row.PhoneNumber || '');\n\n  out.push({\n    json: {\n      ...row,\n      vapi_customer_name: cleanedName,\n      vapi_phone: cleanPhone\n    }\n  });\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -864,
        112
      ],
      "id": "8e0d2770-4ab7-4d29-8c60-d722555eacd5",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// ✅ Safe HTTP version – no axios, no template brackets, works in n8n Cloud\n\nconst url = \"https://api.vapi.ai/call/phone\";\n\nconst payload = {\n  phoneNumberId: $json.phoneNumberId,\n  customer: {\n    number: \"+\" + $json.phone,\n    name: $json.vapi_customer_name,\n  },\n  assistantId: \"ac83d07b-d70d-4a72-8903-97f00226deb1\",\n};\n\ntry {\n  const res = await this.helpers.httpRequest({\n    method: 'POST',\n    url,\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"Authorization\": \"5bc6f98f-1199-4aff-9afa-3edd9f19cc45\",\n    },\n    body: payload,\n    json: true,\n    timeout: 20000\n  });\n\n  return [{\n    json: {\n      ...$json,\n      callStatus: 'success',\n      vapiResponse: res\n    }\n  }];\n\n} catch (err) {\n  const message = err.error?.message || err.message || 'Unknown API error';\n  return [{\n    json: {\n      ...$json,\n      callStatus: 'failed',\n      error: message\n    }\n  }];\n}\n"
      },
