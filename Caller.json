    {
      "parameters": {
        "jsCode": "const first = (items[0] && items[0].json) || {};\nconst keys = Object.keys(first);\nconst norm = s => String(s).toLowerCase().replace(/\\s+/g,'');\n\nconst statusKey = keys.find(k => norm(k)==='status') || 'Status';\nconst idKey = keys.find(k => ['phonenumberid','phonenumberid','numberid','a'].includes(norm(k))) || 'Phone Number Id';\n\nconst active = items.filter(i => String(i.json[statusKey]||'').toLowerCase().trim()==='active');\nif (!active.length) throw new Error(`No ACTIVE rows in Phone Numbers (check column \"${statusKey}\")`);\n\nconst pick = active[Math.floor(Math.random()*active.length)];\nreturn [{ json: { phoneNumberId: String(pick.json[idKey]||'').trim() } }];\n"
      },
